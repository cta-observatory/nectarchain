# NectarCAM DQM web application — environment file.
#
# Install as /etc/dqm/dqm-web-app.env with:
#   sudo mkdir -p /etc/dqm
#   sudo install -m 600 -o nectarcam -g cta dqm-web-app.env /etc/dqm/dqm-web-app.env
# then edit the values below. systemd reads this file at service start;
# if a value contains spaces or '#', wrap it in double quotes.
#
# Shared account used by the web app login page.
DQM_AUTH_USER=foo
DQM_AUTH_PASSWORD=<CHANGE_ME>

# Secret used to sign the login session cookies (12 h lifetime). Generate one
# with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it private; changing it invalidates all active sessions.
DQM_AUTH_SECRET=<CHANGE_ME>

# Set to 0 only if the service is served over plain http (e.g. local testing).
# DQM_AUTH_COOKIE_SECURE=1

# URL path under which the app is exposed; the login/logout endpoints are
# served under it (e.g. /bokeh_app/login). Only change this if the app is
# served on another path than /bokeh_app.
# DQM_AUTH_URL_PREFIX=/bokeh_app
